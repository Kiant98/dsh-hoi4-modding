    "tank-designer",
    "scripted-gui",
    "localisation",
    "dds",
    "cjk-fonts"
  ],
  "author": "kiant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kiant98/dsh-hoi4-modding.git"
  },
  "homepage": "https://github.com/Kiant98/dsh-hoi4-modding#readme",
  "bugs": {
    "url": "https://github.com/Kiant98/dsh-hoi4-modding/issues"
  },
